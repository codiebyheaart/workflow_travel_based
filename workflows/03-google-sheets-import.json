{
  "name": "TrailDesk 03 — Import Existing Google Sheet Customers",
  "nodes": [
    {
      "id": "7c8130be-8301-4b70-8000-000000000008",
      "name": "Manual Import",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        -600,
        0
      ],
      "parameters": {}
    },
    {
      "id": "7c8130be-8301-4b70-8000-000000000009",
      "name": "Read Customer Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        -350,
        0
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Customers",
          "mode": "name"
        },
        "options": {}
      }
    },
    {
      "id": "7c8130be-8301-4b70-8000-000000000010",
      "name": "Collect Valid Customers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ],
      "parameters": {
        "jsCode": "const rows = $input.all().map(i => i.json).filter(r => r.phone && r.name).map(r => ({ phone: String(r.phone), name: String(r.name) })); return [{ json: { rows } }];"
      }
    },
    {
      "id": "7c8130be-8301-4b70-8000-000000000011",
      "name": "Import to TrailDesk",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        150,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:4100/internal/customers/import",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.TRAILDESK_INTERNAL_API_KEY }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Manual Import": {
      "main": [
        [
          {
            "node": "Read Customer Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Customer Sheet": {
      "main": [
        [
          {
            "node": "Collect Valid Customers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Collect Valid Customers": {
      "main": [
        [
          {
            "node": "Import to TrailDesk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}

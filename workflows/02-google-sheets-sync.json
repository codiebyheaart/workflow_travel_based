{
  "name": "TrailDesk 02 — Sync Leads to Google Sheets",
  "nodes": [
    {
      "id": "7c8130be-8301-4b70-8000-000000000004",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -600,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "7c8130be-8301-4b70-8000-000000000005",
      "name": "Read Lead Snapshot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -350,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "http://127.0.0.1:4100/internal/leads",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-internal-key",
              "value": "={{ $env.TRAILDESK_INTERNAL_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "7c8130be-8301-4b70-8000-000000000006",
      "name": "One Item Per Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -100,
        0
      ],
      "parameters": {
        "jsCode": "return $input.all().flatMap(item => (Array.isArray(item.json) ? item.json : [item.json]).map(row => ({ json: row })));"
      }
    },
    {
      "id": "7c8130be-8301-4b70-8000-000000000007",
      "name": "Upsert Google Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        150,
        0
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [
            "id"
          ],
          "schema": []
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Read Lead Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read Lead Snapshot": {
      "main": [
        [
          {
            "node": "One Item Per Lead",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One Item Per Lead": {
      "main": [
        [
          {
            "node": "Upsert Google Sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": []
}
